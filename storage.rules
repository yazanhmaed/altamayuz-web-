rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Same owner UID as firestore.rules (the admin_app login).
    function isOwner() {
      return request.auth != null && request.auth.uid == "COg18UgDwebX2XJNDhezTG7GCzb2";
    }

    // Product photos (`products/{productId}/{color}.jpg`): readable by
    // everyone (the public storefront displays them directly by URL). Only
    // the admin uploads them — images up to 5 MB — and only the admin deletes
    // them (a failed product save cleans up its fresh uploads).
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner();
    }
  }
}
