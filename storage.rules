rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Product photos: readable by everyone (the public storefront displays
    // them directly by URL), writable only by the admin.
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == "YOUR_ADMIN_UID";
    }
  }
}
