rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the Firebase Auth UID of the store owner (admin_app login).
    function isOwner() {
      return request.auth != null && request.auth.uid == "COg18UgDwebX2XJNDhezTG7GCzb2";
    }

    // The storefront reads products directly. Anyone may read; only the owner
    // writes (admin app). Stock deduction happens server-side in the
    // submitPublicOrder Cloud Function, which uses the Admin SDK and bypasses
    // these rules.
    match /products/{productId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Orders are created only by the submitPublicOrder Cloud Function (Admin
    // SDK) or the owner. No client — storefront included — writes here directly.
    match /orders/{orderId} {
      allow read, write: if isOwner();
    }

    // Owner-only, except `cartDiscountTiers`: the storefront (unauthenticated)
    // reads that one document directly to show cart-wide quantity discounts at
    // checkout. Writes stay owner-only; the server re-sanitizes on every order
    // regardless, so a public read is harmless.
    match /settings/{docId} {
      allow read: if isOwner() || docId == "cartDiscountTiers";
      allow write: if isOwner();
    }

    // Customer records hold private personal data (name, phone, address,
    // marketing consent). Written by submitPublicOrder (Admin SDK) or the
    // owner; never readable or writable from the public storefront.
    match /customers/{id} {
      allow read, write: if isOwner();
    }

    // Manual WhatsApp offer campaigns and who received each one. Owner-only.
    match /campaigns/{id} {
      allow read, write: if isOwner();

      match /sent/{phone} {
        allow read, write: if isOwner();
      }
    }
  }
}
